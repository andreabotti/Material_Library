# ── Microsoft 365 sign-in (libs/lib_auth_m365.py) ────────────────────────────
# Adds a "Sign in with Microsoft" button to the startup gate, next to the
# username/password form. Entra ID authorization code flow, delegated scopes.
# tenant_id / client_id / client_secret fall back to [sharepoint] above, so one
# app registration can serve both — but redirect_uri must be registered on it
# (Entra ID → App registrations → Authentication → Web → Redirect URIs) and has
# no fallback: without it the Microsoft button stays hidden.
[m365]
# The app registration is inherited from [sharepoint] above. Uncomment these three
# only to point the Microsoft sign-in at a *separate* registration.
# tenant_id     = ""
# client_id     = ""
# client_secret = ""

# THE SWITCH. Until this is uncommented the Microsoft button stays hidden and the
# password form is the only way in. Register the exact same URI first:
# Entra ID → App registrations → Authentication → Web → Redirect URIs.
# The port must be the one MatLib actually serves on (8502 per .claude/launch.json).
# redirect_uri  = "http://localhost:8502/"

scopes          = ["User.Read"]   # MSAL adds openid/profile/offline_access itself
allowed_domains = ["eetra.it"]    # empty/omitted → any account in the tenant
admin_users     = ["a.botti@eetra.it"]
developer_users = []              # UPNs that get the developer role
default_role = ""
