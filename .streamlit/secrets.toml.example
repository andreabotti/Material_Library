[doc_storage]
# Flip to true once the bucket below is populated (see
# 04_tools/07_upload_pdfs_to_buckets.py). While false, the app reads
# EPD/tech-sheet PDFs from 01_data/pdf and product images from 01_data/img
# only, exactly as before.
enabled = false
# Cloudflare R2 only. R2's free tier is 10 GB with zero egress charges, which
# covers the ~1.25 GB of documents + image originals with room to spare;
# Supabase's free Storage tier is 1 GB, so the PDFs alone do not fit, and its
# paid tier is $25/mo for the same job. The [supabase] block below is kept so
# the fallback path still works if a second provider is ever wanted.
provider_order = ["cloudflare_r2"]

[supabase]
# Project Settings -> API. Storage bucket must be public for this read path.
url = ""
bucket = ""
# Service role key is only needed by the upload script (04_tools/07_...), never by the app itself.
service_role_key = ""

[cloudflare_r2]
# Cloudflare dashboard -> R2 -> your bucket -> Settings -> Public access
# (enable r2.dev subdomain, or bind a custom domain) for public_base_url.
account_id = ""
bucket = ""
public_base_url = ""
# Access keys are only needed by the upload script (04_tools/07_...), never by the app itself.
access_key_id = ""
secret_access_key = ""

