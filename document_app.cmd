# ── 11. Complete file manifest (every code/config/markup file) ──────────────
# One consolidated per-file index of every .py / .json / .html / .css / .cmd
# file in the project, EXCLUDING the data files under 01_data/ (EPD JSON/PDF/
# HTML, images, ILCD XML) and the excluded dirs above. This is the "what does
# each file do" reference.
w("## 11. Complete file manifest (code, config, markup)")
w()
w("*Every `.py` / `.json` / `.html` / `.css` / `.cmd` file, excluding data "
  "files under `01_data/` and generated caches. One line per file.*")
w()

_MANIFEST_SUFFIXES = {".py", ".json", ".html", ".css", ".cmd"}
_MANIFEST_SKIP_TREES = {"01_data"}  # data-only tree — excluded per doc scope


def html_first_comment(p: Path) -> str:
    try:
        head = p.read_text(encoding="utf-8", errors="replace")[:2000]
    except Exception:
        return ""
    m = re.search(r"<!--\s*(.+?)\s*-->", head, re.DOTALL)
    if m:
        return re.sub(r"\s+", " ", m.group(1)).strip()[:160]
    m = re.search(r"<title>\s*(.+?)\s*</title>", head, re.IGNORECASE | re.DOTALL)
    return re.sub(r"\s+", " ", m.group(1)).strip()[:160] if m else ""


def file_one_liner(p: Path) -> str:
    suf = p.suffix.lower()
    if suf == ".py":
        return py_summary(p)["doc"] or "(no module docstring)"
    if suf == ".cmd":
        return "Self-documenting generator — regenerates `APP_DOCUMENTATION.md` (this file)."
    if suf == ".json":
        note = JSON_PURPOSE.get(p.name)
        if note:
            return note
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                kk = [k for k in data.keys() if not k.startswith("_")][:8]
                return "keys: " + ", ".join(f"`{k}`" for k in kk)
            if isinstance(data, list):
                return f"list of {len(data)} entries"
        except Exception:
            return ""
        return ""
    if suf in (".html", ".css"):
        return HTML_NOTES.get(p.name) or html_first_comment(p)
    return ""


# Collect files grouped by their directory (relative to ROOT).
_manifest: dict[str, list[tuple[str, str]]] = {}
for p in sorted(ROOT.rglob("*")):
    if not p.is_file() or p.suffix.lower() not in _MANIFEST_SUFFIXES:
        continue
    parts = p.relative_to(ROOT).parts
    if _is_excluded(parts) or (set(parts) & _MANIFEST_SKIP_TREES):
        continue
    group = str(p.parent.relative_to(ROOT)).replace("\\", "/")
    group = "(project root)" if group == "." else f"{group}/"
    _manifest.setdefault(group, []).append((p.name, file_one_liner(p)))

# Emit: root first, then the rest alphabetically.
_order = sorted(_manifest, key=lambda g: (g != "(project root)", g))
for group in _order:
    w(f"### `{group}`")
    w()
    w("| File | Purpose |")
    w("|---|---|")
    for name, desc in sorted(_manifest[group]):
        w(f"| `{name}` | {desc} |")
    w()


def embed_md(title: str, fname: str, rendered_by: str = "", *, reason: str = "") -> None:
    """Embed a markdown source file as a section (heading levels shifted).

    Most embedded files are separate because the app renders them at runtime —
    pass *rendered_by* for those. One kept separate for another reason (an
    operational runbook, say) passes *reason* and states its own.
    """
    w(f"## {title}")
    w()
    p = ROOT / fname
    if not p.exists():
        w(f"*(`{fname}` not found)*")
        w()
        return
    why = reason or f"it is rendered live by {rendered_by}"
    w(f"*Embedded from `{fname}` — kept as a separate file because {why}. "
      f"Edit the source file, not this section.*")
    w()
    for line in p.read_text(encoding="utf-8").splitlines():
        # Demote headings so the embedded doc nests under this section.
        w("##" + line if re.match(r"^#{1,4} ", line) else line)
    w()


