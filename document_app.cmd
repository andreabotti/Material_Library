def parquet_info(p: Path) -> str:
    if pd is None:
        return kb(p.stat().st_size)
    try:
        df = pd.read_parquet(p)
        return f"{len(df):,} rows × {len(df.columns)} cols, {kb(p.stat().st_size)}"
    except Exception as e:
        return f"{kb(p.stat().st_size)} (unreadable: {e})"

