# -*- coding: utf-8 -*-
"""
document_app.cmd — EETRA MatLib self-documenting command
=========================================================
ONE file, double-click (or run `document_app.cmd`) from the app root.
The first line makes Windows run this file with Python (-x skips line 1).

Scans the whole application and its data, then writes:

    APP_DOCUMENTATION.md   — full app + data reference (regenerated each run)

Sections: folder map · navigation · pages · libraries (functions/classes) ·
HTML components · tools · tests · config JSON files · data inventory
(parquet/JSON/XML/PDF) · requirements · complete per-file manifest
(every py/json/html/css/cmd file, excluding 01_data data files) ·
database column reference (embedded from DATABASE_COLUMNS.md) ·
CAM 2025 notes (embedded from CAM.md) · remote asset storage (embedded from
REMOTE_ASSET_STORAGE.md).

Note: DATABASE_COLUMNS.md and CAM.md remain separate source files because the
app renders them at runtime (Developer → Schema tab, and the CAM 2025 page);
their content is embedded below so this document is the complete reference.
"""
import ast
import json
import re
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent
OUT = ROOT / "APP_DOCUMENTATION.md"
EXCLUDE_DIRS = {
    ".cache", ".claude", ".pytest_cache", "__pycache__", "__safe_to_delete",
    ".git", ".streamlit", "_archive_2026-07-11",
}


def _is_excluded(parts) -> bool:
    """True if any path part is an excluded dir or an ``_archive*`` snapshot."""
    s = set(parts)
    return bool(s & EXCLUDE_DIRS) or any(str(x).startswith("_archive") for x in parts)

L: list[str] = []  # output lines


def w(s: str = "") -> None:
    L.append(s)


def kb(n: int) -> str:
    return f"{n / 1024:,.0f} KB" if n < 1024 ** 2 else f"{n / 1024 ** 2:,.1f} MB"


def dir_stats(d: Path) -> tuple[int, int]:
    n = size = 0
    for p in d.rglob("*"):
        if p.is_file() and not _is_excluded(p.parts):
            n += 1
            size += p.stat().st_size
    return n, size


def first_doc_line(node) -> str:
    doc = ast.get_docstring(node) or ""
    return doc.strip().splitlines()[0].strip() if doc.strip() else ""


def py_summary(path: Path) -> dict:
    """Module docstring + top-level functions/classes via ast."""
    out = {"doc": "", "funcs": [], "classes": [], "lines": 0}
    try:
        src = path.read_text(encoding="utf-8")
        out["lines"] = src.count("\n") + 1
        tree = ast.parse(src)
        out["doc"] = first_doc_line(tree)
        for node in tree.body:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                out["funcs"].append((node.name, first_doc_line(node)))
            elif isinstance(node, ast.ClassDef):
                out["classes"].append((node.name, first_doc_line(node)))
    except Exception as e:
        out["doc"] = f"(parse error: {e})"
    return out


