  <processInformation>
    <dataSetInformation>
      <common:UUID>06ea922d-348d-432e-871a-c1ce52f2b677</common:UUID>
      <name>
        <baseName xml:lang="en">Aluminium, recycling</baseName>
      </name>
      <common:synonyms>Riciclo di alluminio.</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">End-of-life treatment</common:class>
          <common:class level="1">Material recycling</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment>Dataset developed within the ARCADIA project in the context of the PhD of Federica Carollo (Politecnico di Milano).
The dataset relates to the recycling of 1 kg of aluminium in Italy. 
The dataset is composed of 2-unit processes: 
1) Avoided production of liquid aluminium with a substitution ratio assumed of 1:0,7;
2) Treatment of aluminium scrap (The Process taken by the Ecoinvent 3.8 database was modified by excluding the aluminium scraps).</common:generalComment>
      <referenceToExternalDocumentation type="source data set" refObjectId="78cc8909-4b82-4660-8558-1a8bb9b02701" version="01.00.000" uri="../sources/78cc8909-4b82-4660-8558-1a8bb9b02701.xml">
        <common:shortDescription>Carollo F. (2023). Circularity in construction and demolition waste management chain, Ph.D. Dissertation (Tutored by Rigamonti L., Ceruti F.). Politecnico di Milano. Background datasets from the EcoInvent database cut-off (v. 3.8) were used for the LCA study. </common:shortDescription>
      </referenceToExternalDocumentation>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2022</common:referenceYear>
      <common:dataSetValidUntil>2027</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Lombardy Region.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>100% of aluminium scraps go directly for recycling. &#13;
1,25 kg of aluminium scraps is needed to obtain 1 kg of recycled aluminium. Recycling 1 kg of aluminium scraps can avoid the production of 0,7 kg of primary liquid aluminium.   &#13;
&#13;
Good the Reliability; &#13;
Very Good the Geographical representativeness; &#13;
Very Good the Time representativeness; &#13;
Very Good the Technological representativeness. </technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>Recycling of 1 kg of aluminum.</technologicalApplicability>
    </technology>
  </processInformation>
