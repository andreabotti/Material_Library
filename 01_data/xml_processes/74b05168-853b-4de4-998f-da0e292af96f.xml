  <processInformation>
    <dataSetInformation>
      <common:UUID>74b05168-853b-4de4-998f-da0e292af96f</common:UUID>
      <name>
        <baseName xml:lang="en">Wood veneer, dyed, at production, European wood species</baseName>
      </name>
      <common:synonyms>Piallaccio di legno tinto, realizzato con specie legnose di provenienza europea</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Materials production</common:class>
          <common:class level="1">Wood</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment>Dataset developed within the ARCADIA Project (production chain study regarding wood veneer “STUDIO DI FILIERA PIALLACCIO DI LEGNO”). The dataset involves the dying of natural wood veneer throughout its thickness and is representative of the processing technologies commonly used in wood veneer production.</common:generalComment>
      <referenceToExternalDocumentation type="source data set" refObjectId="a2dd6f02-574f-4fd5-9760-3110010ac18c" version="01.00.000" uri="../sources/a2dd6f02-574f-4fd5-9760-3110010ac18c.xml">
        <common:shortDescription>Scrucca F., Frisone F., Rinaldi, C., 2023. “STUDIO DI FILIERA PIALLACCIO DI LEGNO”. Internal report ARCADIA Project. For the LCA study background datasets from Ecoinvent database cut-off (v. 3.7.1) were used.</common:shortDescription>
      </referenceToExternalDocumentation>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2022</common:referenceYear>
      <common:dataSetValidUntil>2027</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Italy. Primary data collected in Lombardia. Dataset representative of Italian production of dyed wood veneers.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>1 m2 of dyed wood veneer, available for all subsequent transport/processing operations. Production of equipment and infrastructures is not included, except for the background system. Primary data data were collected as physical quantities of materials used in the different processes. Background data were modelled according to Ecoinvent v. 3.7.1</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>Dyed wood veneer in sheets of variable length and width, which can be used for veneering of suitable specific supports (MDF, honeycomb panel, chipboard, multilayer, ...), or to create other specific products (such as plywood, boards, …)</technologicalApplicability>
      <referenceToTechnologyPictogramme type="source data set" refObjectId="437f23f1-c6b6-4411-b6aa-8b0286f80be3" version="01.00.000" uri="../sources/437f23f1-c6b6-4411-b6aa-8b0286f80be3.xml">
        <common:shortDescription>20231130114736_Piallaccio.jpg</common:shortDescription>
      </referenceToTechnologyPictogramme>
    </technology>
  </processInformation>
