      <name>
        <baseName xml:lang="en">1mq volcanic stone slab, thickness 20 mm, natural, at production, density 2500 kg/m3</baseName>
      </name>
      <common:synonyms>1 mq di lastra in pietra vulcanica spessore 20 mm, naturale, alla produzione, densità 2500 kg/m3</common:synonyms>
