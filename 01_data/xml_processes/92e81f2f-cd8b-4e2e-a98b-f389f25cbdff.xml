  <processInformation>
    <dataSetInformation>
      <common:UUID>92e81f2f-cd8b-4e2e-a98b-f389f25cbdff</common:UUID>
      <name>
        <baseName xml:lang="en">Packaging for pizza sauce, processing, at plant, average packaging for 1 kg of pizza sauce</baseName>
      </name>
      <common:synonyms>1 kg di Imballaggio della salsa pizza, confezionamento del pomodoro lavorato allo stabilimento</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Packaging</common:class>
          <common:class level="1">Packaging</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment xml:lang="en">The dataset has been developed within the Arcadia Project. It concerns the processing of industrial tomatoes in reference to the report “Studio LCA della filiera dell’industria del pomodoro confezionato in Italia”.</common:generalComment>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2021</common:referenceYear>
      <common:dataSetValidUntil>2028</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Italy. Primary data collected in the North. Representative dataset of the Italian tomato chain production.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>These packaging are used by processor companies to contain the pizza sauce once the processing steps have been completed. Reference is made to the average packaging used for pizza sauce, including primary, secondary, and tertiary packaging, calculated on the average of the main packaging used by processor companies (aluminum, glass, steel, plastic, cardboard, wood). Primary (Italian supply chain) and secondary (literature and/or industry data) data, representative of the Italian supply chain in terms of geographical characteristics and technologies used (machinery, equipment, etc.), were collected. Inventory data were collected as physical quantities of materials used in different processes.&#13;
Background data were modelled according to Ecoinvent v. 3.8</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>These packaging are specially sealed to ensure proper containment of the pizza sauce all the way to the consumer.</technologicalApplicability>
    </technology>
  </processInformation>
