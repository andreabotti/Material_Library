      <name>
        <baseName xml:lang="en">1 mq  monogenic breccia slab thickness 20 mm, bush-hammered, at production, density 2400 kg/m3</baseName>
      </name>
      <common:synonyms>1 mq di lastra in breccia monogenica spessore 20 mm, bocciardata, alla produzione, densità 2400 kg/m3</common:synonyms>
