  <processInformation>
    <dataSetInformation>
      <common:UUID>d56fb9f0-f59d-4390-bbdb-da3d4379a348</common:UUID>
      <name>
        <baseName xml:lang="en">Wooden floor, hardwood finishing, at production, unspecified</baseName>
      </name>
      <common:synonyms>Pavimento in legno con finitura in legno nobile, alla produzione, non specificato</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Materials production</common:class>
          <common:class level="1">Wood</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment>Dataset developed within the ARCADIA Project (production chain study regarding forest wood chips “STUDIO DI FILIERA DEI PAVIMENTI IN LEGNO”).
The dataset refers to the production of an average hardwood floor and it can be considered representative of the Italian average processing technologies commonly used for the production of wooden floors</common:generalComment>
      <referenceToExternalDocumentation type="source data set" refObjectId="d35a2378-7a1f-484a-89fb-a60651206012" version="01.00.000" uri="../sources/d35a2378-7a1f-484a-89fb-a60651206012.xml">
        <common:shortDescription>Scrucca F., Frisone F., Rinaldi, C. 2023. “STUDIO DI FILIERA DEI PAVIMENTI IN LEGNO”. Internal report ARCADIA Project. For the LCA study background datasets from Ecoinvent database cut-off (v. 3.7.1) were used.</common:shortDescription>
      </referenceToExternalDocumentation>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2022</common:referenceYear>
      <common:dataSetValidUntil>2027</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Primary data collected in Veneto. Dataset representative of the production of 1 m2 wooden floor with hardwood finishing in Italy.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>1 m2 of wooden floor with a birch plywood support and an unspecified hardwood finishing glued together with high-strength polyurethane glue. Production of equipment and infrastructures is not included, except for the background system. Primary data (Veneto) and secondary data (literature and/or sector data) representative of the Italian production were collected. Inventory data were collected as physical quantities of materials used in the different processes. Background data were modelled according to Ecoinvent v. 3.7.1</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>The product is used for internal floors finishing in buildings.</technologicalApplicability>
      <referenceToTechnologyPictogramme type="source data set" refObjectId="b6cb7fc1-f329-454c-93a9-b56ede3d5cc7" version="01.00.000" uri="../sources/b6cb7fc1-f329-454c-93a9-b56ede3d5cc7.xml">
        <common:shortDescription>20231130094505_Unspecified.jpg</common:shortDescription>
      </referenceToTechnologyPictogramme>
    </technology>
  </processInformation>
