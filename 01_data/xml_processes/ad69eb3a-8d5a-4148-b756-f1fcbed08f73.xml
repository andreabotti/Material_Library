  <processInformation>
    <dataSetInformation>
      <common:UUID>ad69eb3a-8d5a-4148-b756-f1fcbed08f73</common:UUID>
      <name>
        <baseName xml:lang="en">Steel square and rectangular hollow sections, heat treated, at plant</baseName>
      </name>
      <common:synonyms>Profili cavi quadri e rettangolari in acciaio con trattamento termico</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Materials production</common:class>
          <common:class level="1">Metals and semimetals</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment>Dataset developed within the ARCADIA Project (production chain study regarding steel products “STUDIO DI FILIERA ACCIAIO PER COSTRUZIONI IN CARPENTERIA METALLICA”). The dataset involves beams and angles with various profiles produced from scrap from recycling and is representative of the processing technologies commonly used in steel beams and angles production.</common:generalComment>
      <referenceToExternalDocumentation type="source data set" refObjectId="ca921b7e-37b3-492a-9d19-b7cba9c9de26" version="01.00.000" uri="../sources/ca921b7e-37b3-492a-9d19-b7cba9c9de26.xml">
        <common:shortDescription>Scrucca F., Ceruti F., Sesana M.M., Martelli S.M, Rinaldi, C., 2023. “STUDIO DI FILIERA CCIAIO PER COSTRUZIONI IN CARPENTERIA METALLICA”. Internal report ARCADIA Project. For the LCA study background datasets from Ecoinvent database cut-off (v. 3.7.1) were used.</common:shortDescription>
      </referenceToExternalDocumentation>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2023</common:referenceYear>
      <common:dataSetValidUntil>2028</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Italy. Primary data collected in Lombardia. Dataset representative of Italian production of steel square and rectangular hollow sections with hot treatment.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>1 kg of steel square and rectangular hollow sections with hot treatment, available for all subsequent transport/processing operations. Hollow sections are produced using a mix of steel coils from EAF (Electric Arc Furnace) and BOF (Basic Oxigen Furnace) and the studied product is representative of an average of cold and hot rolled hollow sections. Production of equipment and infrastructures is not included, except for the background system. Primary data data were collected as physical quantities of materials used in the different processes. Background data were modelled according to Ecoinvent v. 3.7.1</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>Steel square and rectangular hollow sections with hot treatment for structural use, produced in accordance with EN standards EN10219-1; EN 10219-2; EN 10210-1; EN 10210-2.</technologicalApplicability>
      <referenceToTechnologyPictogramme type="source data set" refObjectId="6998b19d-90ef-4c28-9a91-811f56b11915" version="01.00.000" uri="../sources/6998b19d-90ef-4c28-9a91-811f56b11915.xml">
        <common:shortDescription>20231130125528_Profili cavi_tratt-termico.jpg</common:shortDescription>
      </referenceToTechnologyPictogramme>
    </technology>
  </processInformation>
