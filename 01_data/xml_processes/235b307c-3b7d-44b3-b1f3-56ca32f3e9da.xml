  <processInformation>
    <dataSetInformation>
      <common:UUID>235b307c-3b7d-44b3-b1f3-56ca32f3e9da</common:UUID>
      <name>
        <baseName xml:lang="en">Timber, in logs, fir at production, Silver fir and spruce mix</baseName>
      </name>
      <common:synonyms>Legname di abete in tronchi, alla produzione, mix abete bianco e rosso</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Materials production</common:class>
          <common:class level="1">Wood</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment xml:lang="en">Dataset developed within the ARCADIA Project (production chain study regarding forest wood chips “STUDIO DI FILIERACIPPATO FORESTALE”).&#13;
The dataset involves the use of mechanical means for felling and on-site handling of the timber and is representative of the processing technologies commonly used in the wood harvesting in mountain environment.&#13;
</common:generalComment>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2021</common:referenceYear>
      <common:dataSetValidUntil>2026</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Northern Italy. Primary data collected in Friuli Venezia Giulia. Dataset representative of regions where wood harvesting occurs mainly in mountain environment (or similar)</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>1 m3 of fir timber logs, as silver fir and spruce mix, obtained from the felling of trees by mechanical means and their handling inside the forest, available for all subsequent transport/processing operations. Production of equipment and infrastructures is not included, except for the background system. Primary data and secondary data were collected as physical quantities of materials used in the different processes. Background data were modelled according to Ecoinvent v. 3.7.1</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>The product can be used as a raw material for making construction industry products (beams, boards or other secondary products), as well as a raw material for energy carriers (wood chips, firewood) production</technologicalApplicability>
      <referenceToTechnologyPictogramme type="source data set" refObjectId="9c34d532-6753-4267-90a9-6986e5f3e6aa" version="01.00.000" uri="../sources/9c34d532-6753-4267-90a9-6986e5f3e6aa.xml">
        <common:shortDescription>20230628154932_Legname.jpg</common:shortDescription>
      </referenceToTechnologyPictogramme>
    </technology>
  </processInformation>
