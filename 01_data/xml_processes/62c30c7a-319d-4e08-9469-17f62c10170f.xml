    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT"/>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>The dataset includes the model of the production 1 unit of office table including the end of life of its materials. &#13;
The following life cycle phases are included :&#13;
Manufacturing table components&#13;
Manufacturing table packaging&#13;
Manufacturing  -table&#13;
Distribution&#13;
Use &amp; maintenance&#13;
End of life</technologyDescriptionAndIncludedProcesses>
    </technology>
  </processInformation>
