  <processInformation>
    <dataSetInformation>
      <common:UUID>4c01da27-5bf9-47e8-8cf1-85d7c068e2fe</common:UUID>
      <name>
        <baseName xml:lang="en">Packaging for tomato pulp, processing, at Plant, average packaging for 1 kg of tomato pulp</baseName>
      </name>
      <common:synonyms>1 kg di Imballaggio della polpa di pomodoro, confezionamento del pomodoro lavorato allo stabilimento</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Packaging</common:class>
          <common:class level="1">Packaging</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment xml:lang="en">The dataset has been developed within the Arcadia Project. It concerns the processing of industrial tomatoes in reference to the report “Studio LCA della filiera dell’industria del pomodoro confezionato in Italia”.</common:generalComment>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2021</common:referenceYear>
      <common:dataSetValidUntil>2028</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Italy. Primary data collected in the North and Center-South. Representative dataset of the Italian tomato chain production.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>These packaging are used by processor companies to contain the tomato pulp once the processing steps have been completed. Reference is made to the average packaging used for tomato pulp, including primary, secondary, and tertiary packaging, calculated on the average of the main packaging used by processor companies (aluminum, glass, steel, plastic, cardboard, wood). Primary (Italian supply chain) and secondary (literature and/or industry data) data, representative of the Italian supply chain in terms of geographical characteristics and technologies used (machinery, equipment, etc.), were collected. Inventory data were collected as physical quantities of materials used in different processes.&#13;
Background data were modelled according to Ecoinvent v. 3.8&#13;
</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>These packaging are specially sealed to ensure proper containment of the tomato pulp all the way to the consumer.</technologicalApplicability>
    </technology>
  </processInformation>
