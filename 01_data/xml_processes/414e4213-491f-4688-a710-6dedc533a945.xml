  <processInformation>
    <dataSetInformation>
      <common:UUID>414e4213-491f-4688-a710-6dedc533a945</common:UUID>
      <name>
        <baseName xml:lang="en">Tomato paste, processing, at plant, Northern Italy, 1 kg of tomato paste</baseName>
      </name>
      <common:synonyms>1 kg di Concentrato di pomodoro, trasformazione allo stabilimento, Nord Italia</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Materials production</common:class>
          <common:class level="1">Food and renewable raw materials</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment xml:lang="en">The dataset has been developed within the Arcadia Project. It concerns the processing of industrial tomatoes in reference to the report “Studio LCA della filiera dell’industria del pomodoro confezionato in Italia”.</common:generalComment>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2021</common:referenceYear>
      <common:dataSetValidUntil>2028</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Italy. Primary data collected in the North. Representative dataset of North Italian tomato chain production.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>Tomato paste is processed by removing some of the water from the juice, which is obtained by grinding and sieving fresh tomato fruit. The paste, which differs according to how much the juice concentration increases in percentage, requires tomatoes that are rich in color, with texture and skin resistance to splitting, and with the highest possible content of sugars. Concentration is done by evaporation of water at low pressure in order to safeguard the organoleptic and nutritional properties of the product. Primary (North Italian supply chain) and secondary (literature and/or industry data) data representative of the North Italian supply chain in terms of geographic characteristics and technologies used (machinery, equipment, etc.) were collected. Inventory data were collected as physical quantities of materials used in different processes. Benefits from the use of secondary materials produced by recycling waste materials (e.g., plastics and cardboard) were excluded.&#13;
Background data were modelled according to Ecoinvent v. 3.8</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>Tomato paste is the perfect ingredient for adding additional color and flavor to preparations that require long cooking times.</technologicalApplicability>
    </technology>
  </processInformation>
