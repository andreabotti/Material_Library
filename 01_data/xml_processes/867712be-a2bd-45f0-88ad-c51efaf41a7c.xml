      <name>
        <baseName xml:lang="en">Wood window, 80 mm, pine, at plant</baseName>
      </name>
      <common:synonyms>Produzione di 1 m2 di serramento in legno di pino. Telaio con spessore 80 mm.</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Materials production</common:class>
          <common:class level="1">Wood</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment>Dataset developed within "LIFE MAGIS - Made Green in Italy Scheme" project. The process includes pine wood used for the frame, rubber for the gasket, paint and related supply transportation. Glass is excluded.</common:generalComment>
