  <processInformation>
    <dataSetInformation>
      <common:UUID>0c1a7532-48c8-42d2-9259-136b90ed97df</common:UUID>
      <name>
        <baseName xml:lang="en">Iron and Steel Recycling, without sorting</baseName>
      </name>
      <common:synonyms>Riciclo di ferro e acciaio senza selezione </common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">End-of-life treatment</common:class>
          <common:class level="1">Material recycling</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment>Dataset developed within the ARCADIA project in the context of the Ph.D. of Federica Carollo (Politecnico di Milano). 
The dataset relates to recycling 1 kg of iron and steel in Italy. 
The dataset is composed of 2-unit processes: 
1) Avoided production of liquid steel with a substitution ratio assumed of 1:1; 
2) Secondary steel production (The Process taken by Ecoinvent 3.8 database was modified by excluding the iron scraps).  </common:generalComment>
      <referenceToExternalDocumentation type="source data set" refObjectId="d08b4325-1eeb-4545-bb40-70aba4a299af" version="01.00.000" uri="../sources/d08b4325-1eeb-4545-bb40-70aba4a299af.xml">
        <common:shortDescription>Carollo F. (2023). Circularity in construction and demolition waste management chain, Ph.D. Dissertation (Tutored by Rigamonti L., Ceruti F.). Politecnico di Milano. Background datasets from the EcoInvent database cut-off (v. 3.8) were used for the LCA study. </common:shortDescription>
      </referenceToExternalDocumentation>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2022</common:referenceYear>
      <common:dataSetValidUntil>2027</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Lombardy Region.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>100% of iron waste goes to recycling. Considering a recycling efficiency of 88%, the process permits obtaining liquid steel that can totally substitute primary liquid steel. &#13;
&#13;
Good the Reliability;   &#13;
Very Good the Geographical representativeness;   &#13;
Very Good the Time representativeness;   &#13;
Very Good the Technological representativeness. </technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>Recycling a tonne of ferrous metals without sorting.</technologicalApplicability>
    </technology>
  </processInformation>
