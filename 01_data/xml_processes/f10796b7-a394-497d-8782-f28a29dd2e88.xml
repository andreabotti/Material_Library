  <processInformation>
    <dataSetInformation>
      <common:UUID>f10796b7-a394-497d-8782-f28a29dd2e88</common:UUID>
      <name>
        <baseName xml:lang="en">Forest wood chips, fir, class B (ISO 17225-4), at production, Silver fir and spruce mix</baseName>
      </name>
      <common:synonyms>Cippato forestale classe B, alla produzione, mix abete bianco e rosso</common:synonyms>
      <classificationInformation>
        <common:classification name="ILCDCategories" classes="../ILCDClassification.xml">
          <common:class level="0">Energy carriers and technologies</common:class>
          <common:class level="1">Renewable fuels</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment xml:lang="en">Dataset developed within the ARCADIA Project (production chain study regarding forest wood chips “STUDIO DI FILIERA CIPPATO FORESTALE”). The dataset involves the use of mechanical means for felling and on-site handling of the timber and is representative of the processing technologies commonly used in the wood harvesting in mountain environment. Wood chipping carried out on-site through a mobile chipper.&#13;
</common:generalComment>
      <referenceToExternalDocumentation type="source data set" refObjectId="1b89b957-ad3b-4719-8a2b-8f4244bbc66d" version="01.00.000" uri="../sources/1b89b957-ad3b-4719-8a2b-8f4244bbc66d.xml">
        <common:shortDescription>Scrucca F, Rinaldi, C., Morara E., Argnani A., 2021. “STUDIO DI FILIERA&#13;
CIPPATO FORESTALE”. Internal report ARCADIA Project. For the LCA study background datasets from Ecoinvent database cut-off (v. 3.7.1) were used.</common:shortDescription>
      </referenceToExternalDocumentation>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>0</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2021</common:referenceYear>
      <common:dataSetValidUntil>2026</common:dataSetValidUntil>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="IT">
        <descriptionOfRestrictions>Northern Italy. Primary data collected in Friuli Venezia Giulia. Dataset representative of regions where wood harvesting occurs mainly in mountain environment (or similar)</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses>1 tonne of forest wood chips, as a mix of silver fir and spruce, obtained from forest virgin wood, available for transportation for subsequent intended uses. Production of equipment and infrastructures is not included, except for the background system. Primary data and secondary data were collected as physical quantities of materials used in the different processes. Background data were modelled according to Ecoinvent v. 3.7.1</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability>The product can be used as energetic raw material, for electricity production or combined heat-power generation, in medium to large size plant</technologicalApplicability>
      <referenceToTechnologyPictogramme type="source data set" refObjectId="9c34d532-6753-4267-90a9-6986e5f3e6aa" version="01.00.000" uri="../sources/9c34d532-6753-4267-90a9-6986e5f3e6aa.xml">
        <common:shortDescription>20230628164832_Classe-B.jpg</common:shortDescription>
      </referenceToTechnologyPictogramme>
    </technology>
  </processInformation>
